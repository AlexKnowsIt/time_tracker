# Kopieren nach .env und anpassen. .env gehört nie ins Repo.

# Pflicht: langer, zufälliger Schlüssel, z. B.
#   python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=

# Im Betrieb leer lassen oder 0. Nur für Entwicklung 1.
DJANGO_DEBUG=0

# Kommagetrennt, ohne Schema: Hostnamen, unter denen die App erreichbar ist
DJANGO_ALLOWED_HOSTS=zeit.example.org

# Kommagetrennt, mit Schema: Ursprung(e) hinter dem HTTPS-Proxy (sonst scheitern Logins/POSTs)
DJANGO_CSRF_TRUSTED_ORIGINS=https://zeit.example.org

# Im Container schon auf /data/db.sqlite3 gesetzt (Volume). Lokal Standard: db.sqlite3
# DJANGO_DB_PATH=/data/db.sqlite3
